# Environment Variables Template

# Email Service (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics
# Get your tracking ID from: https://analytics.google.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console Verification
# Get your verification code from: https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-verification-code-here

# Razorpay Credentials (Required for domestic checkout)
# Get yours from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Calendly Booking Link (Replace with your actual event url)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username/event-name
