// Prisma schema synced with Supabase Database
// Last updated: 2026-01-28

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// PROFILES - Maps to public.profiles (synced with auth.users via trigger)
model profiles {
  id         String   @id @db.Uuid
  email      String?
  full_name  String?
  avatar_url String?
  role       String?  @default("student")
  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  courses_taught courses[]     @relation("InstructorCourses")
  enrollments    enrollments[]
  
  // Phase 2 Relations
  quiz_results   quiz_results[]
  live_classes   live_classes[]   @relation("InstructorClasses")
  notifications  notifications[]
  device_tokens  device_tokens[]
  video_progress video_progress[]
}

// COURSES
model courses {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title          String
  subtitle       String?
  description    String?
  price          Float
  original_price Float?
  thumbnail_url  String?
  instructor_id  String?  @db.Uuid
  rating         Float?   @default(0)
  reviews_count  Int?     @default(0)
  is_published   Boolean? @default(false)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  instructor  profiles?     @relation("InstructorCourses", fields: [instructor_id], references: [id])
  modules     modules[]
  enrollments enrollments[]
  
  // Phase 2 Relations
  live_classes live_classes[]
  quizzes      quizzes[]
}

// MODULES / SECTIONS
model modules {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  course_id   String   @db.Uuid
  title       String
  order_index Int
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  course courses  @relation(fields: [course_id], references: [id])
  videos videos[]
  quizzes quizzes[]
}

// VIDEOS / LESSONS
model videos {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  module_id       String   @db.Uuid
  title           String
  duration        String?
  video_url       String?
  thumbnail_url   String?
  is_free_preview Boolean? @default(false)
  order_index     Int
  unlock_at       DateTime? @db.Timestamptz(6) // Scheduled release time
  video_library_id String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  module modules @relation(fields: [module_id], references: [id])
  library_video video_library? @relation(fields: [video_library_id], references: [id])
  
  // Phase 2 Relations
  questions      questions[]
  quiz_results   quiz_results[]
  video_progress video_progress[]
  quizzes        quizzes[]
}

// VIDEO LIBRARY - Central repository
model video_library {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title      String
  filename   String
  video_url  String
  thumbnail_url String?
  duration   Int?
  size_bytes BigInt?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  linked_videos videos[]
}

// ENROLLMENTS
model enrollments {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String   @db.Uuid
  course_id   String   @db.Uuid
  payment_id  String?
  amount_paid Float?
  enrolled_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  user   profiles @relation(fields: [user_id], references: [id])
  course courses  @relation(fields: [course_id], references: [id])

  @@unique([user_id, course_id])
}

// ============================================
// PHASE 2 & 9: QUIZ & MOCK TEST FEATURE
// ============================================

model quizzes {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title              String
  description        String?
  type               String   // 'VIDEO', 'MODULE', 'SUBJECT', 'MOCK'
  
  // Context
  video_id           String?  @db.Uuid
  module_id          String?  @db.Uuid
  course_id          String?  @db.Uuid
  
  // Config
  time_limit_minutes Int?
  passing_percentage Int?     @default(70)
  
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // Relations
  video    videos?   @relation(fields: [video_id], references: [id], onDelete: SetNull)
  module   modules?  @relation(fields: [module_id], references: [id], onDelete: SetNull)
  course   courses?  @relation(fields: [course_id], references: [id], onDelete: SetNull)
  
  questions     questions[]
  quiz_results  quiz_results[]
}

model questions {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  video_id        String?  @db.Uuid // kept for legacy reference, migrated to quiz_id
  quiz_id         String?  @db.Uuid
  
  question_text   String
  option_a        String
  option_b        String
  option_c        String?
  option_d        String?
  correct_option  String   // 'A', 'B', 'C', 'D'
  explanation     String?
  order_index     Int?     @default(1)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  video videos?  @relation(fields: [video_id], references: [id], onDelete: Cascade)
  quiz  quizzes? @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
}

model quiz_results {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id         String   @db.Uuid
  video_id        String?  @db.Uuid // kept for legacy reference
  quiz_id         String?  @db.Uuid
  
  score           Int
  total_questions Int
  completed_at    DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  user  profiles @relation(fields: [user_id], references: [id], onDelete: Cascade)
  video videos?  @relation(fields: [video_id], references: [id], onDelete: Cascade)
  quiz  quizzes? @relation(fields: [quiz_id], references: [id], onDelete: Cascade)

  // @@unique([user_id, video_id]) // Removed strict unique constraint on video_id for now
}

// ============================================
// PHASE 2: LIVE CLASSES
// ============================================

model live_classes {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title            String
  description      String?
  course_id        String?  @db.Uuid
  instructor_id    String   @db.Uuid
  scheduled_at     DateTime @db.Timestamptz(6)
  duration_minutes Int?     @default(60)
  max_participants Int?     @default(100)
  jitsi_room_id    String   @unique
  is_active        Boolean  @default(false)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  thumbnail_url    String?

  course     courses? @relation(fields: [course_id], references: [id], onDelete: SetNull)
  instructor profiles @relation("InstructorClasses", fields: [instructor_id], references: [id], onDelete: Cascade)
}

model video_progress {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String   @db.Uuid
  video_id         String   @db.Uuid
  position_seconds Int?     @default(0)
  is_completed     Boolean? @default(false)
  last_watched_at  DateTime? @default(now()) @db.Timestamptz(6)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)

  user  profiles @relation(fields: [user_id], references: [id], onDelete: Cascade)
  video videos   @relation(fields: [video_id], references: [id], onDelete: Cascade)

  @@unique([user_id, video_id])
  @@index([user_id])
  @@index([video_id])

}

// ============================================
// PHASE 11: COUPONS
// ============================================

model coupons {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code           String    @unique
  discount_type  String    // 'PERCENTAGE' or 'FIXED'
  discount_value Int
  
  start_date     DateTime? @default(now()) @db.Timestamptz(6)
  expiry_date    DateTime? @db.Timestamptz(6)
  
  usage_limit    Int?
  usage_count    Int?      @default(0)
  
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
}
// ============================================
// PHASE 2: NOTIFICATIONS
// ============================================

model notifications {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String   @db.Uuid
  title      String
  body       String
  type       String?  // 'new_content', 'live_class', 'reminder', 'system'
  data       Json?
  is_read    Boolean? @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  user profiles @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model device_tokens {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String   @db.Uuid
  token      String
  platform   String?  // 'ios', 'android', 'web'
  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  user profiles @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, token])
}




// ============================================
// PHASE 14: LEADS & CONTACT
// ============================================

model leads {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  full_name        String
  phone_number     String
  message          String?
  status           String?  @default("new") // new, contacted, scheduled, completed, rx_sent, converted, follow_up, closed
  source           String?  @default("google") // google, instagram, facebook, referral, direct, whatsapp
  notes            String?
  patient_id       String?  @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // Relations
  timeline           lead_timeline[]
  communication_logs communication_logs[]
  appointments       appointments[]
}

// ============================================
// PHASE 15: CLINIC MANAGEMENT & PRESCRIPTIONS
// ============================================

model doctors {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name           String
  registration   String
  specialization String?
  email          String?  @unique
  signature_url  String?
  stamp_url      String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // Relations
  prescriptions prescriptions[]
  appointments  appointments[]
}

model patients {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String
  phone        String   @unique
  gender       String?
  age          Int?
  dob          DateTime? @db.Date
  address      String?
  blood_group  String?
  allergies    String?  @default("None")
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // Relations
  prescriptions      prescriptions[]
  appointments        appointments[]
  communication_logs communication_logs[]
}

model prescriptions {
  id                  String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  prescription_no     String   @unique // Auto-formatted, e.g. AY-2026-000182
  patient_id          String   @db.Uuid
  doctor_id           String   @db.Uuid
  visit_type          String   @default("online")
  consultation_date   DateTime @default(now()) @db.Date
  chief_complaint     String?
  diagnosis           String?
  blood_pressure      String?
  pulse               String?
  weight              String?
  temperature         String?
  doctor_notes        String?
  tests_advised       String?
  next_followup_date  DateTime? @db.Date
  pdf_url             String?
  status              String   @default("active") // active, cancelled
  
  // Audit Trail
  created_by         String?
  updated_by         String?
  sent_at            DateTime? @db.Timestamptz(6)
  printed_at         DateTime? @db.Timestamptz(6)
  
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // Relations
  patient   patients                 @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctor    doctors                  @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  medicines prescription_medicines[]
}

model prescription_medicines {
  id              String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  prescription_id String @db.Uuid
  medicine_name   String
  dosage          String
  timing          String
  duration        String
  remarks         String?
  display_order   Int    @default(0)

  // Relations
  prescription prescriptions @relation(fields: [prescription_id], references: [id], onDelete: Cascade)
}

model medicine_templates {
  id          String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String @unique
  description String?
  medicines   Json
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}

model lead_timeline {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lead_id     String   @db.Uuid
  status      String
  note        String
  created_by  String?  @default("System")
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  lead        leads    @relation(fields: [lead_id], references: [id], onDelete: Cascade)
}

model communication_logs {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lead_id     String?  @db.Uuid
  patient_id  String?  @db.Uuid
  type        String   // whatsapp, sms, email, call
  log_type    String   // prescription_sent, lead_reply, reminder
  message     String
  status      String   @default("sent") // sent, failed, pending
  created_by  String?  @default("System")
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  lead        leads?    @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  patient     patients? @relation(fields: [patient_id], references: [id], onDelete: Cascade)
}

model appointments {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  patient_id         String?  @db.Uuid
  lead_id            String?  @db.Uuid
  doctor_id          String   @db.Uuid
  appointment_date   DateTime @db.Date
  appointment_time   String   // e.g. "10:30 AM"
  mode               String   @default("online") // online, offline
  duration_minutes   Int      @default(30)
  status             String   @default("scheduled") // scheduled, completed, cancelled, missed
  notes              String?
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // Relations
  patient            patients? @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  lead               leads?    @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  doctor             doctors   @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
}

